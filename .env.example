# =============================================================================
# TOMANNI WEAR: ENVIRONMENT VARIABLES
# =============================================================================
# Copy to .env.local and fill in. Never commit a filled-in copy: .env* is
# gitignored and the pre-commit hook refuses any staged env file except this one.
#
# Preview and production values live in the Vercel project settings, not in a
# file. Pull them locally with: vercel env pull .env.local
# =============================================================================

# ── Database: Supabase Postgres via Prisma ───────────────────────────────────
# DATABASE_URL goes through the pooler; DIRECT_URL is the direct connection
# that migrations need.
DATABASE_URL=
DIRECT_URL=

# ── Auth: NextAuth ───────────────────────────────────────────────────────────
# AUTH_SECRET: generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=

# ── Admin access ─────────────────────────────────────────────────────────────
# ADMIN_EMAILS is comma separated.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# ── Payments: Paystack (NGN) ─────────────────────────────────────────────────
# Use the test keys locally. The NEXT_PUBLIC_ one reaches the browser.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── CMS: Sanity ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# ── Email: Resend ────────────────────────────────────────────────────────────
# REVIEW_NOTIFY_EMAILS is comma separated.
RESEND_API_KEY=
REVIEW_NOTIFY_EMAILS=

# ── Analytics ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Cache: Vercel KV / Redis ─────────────────────────────────────────────────
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
REDIS_URL=

# ── Playwright ───────────────────────────────────────────────────────────────
# BASE_URL defaults to http://localhost:3000 and the local web server starts
# itself. In CI it must point at a deployment.
# VERCEL_AUTOMATION_BYPASS_SECRET lets CI past Vercel Deployment Protection.
# PLAYWRIGHT_RETRIES overrides the default (2 in CI, 0 locally).
BASE_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=
PLAYWRIGHT_RETRIES=

# ── Managed automatically ────────────────────────────────────────────────────
# VERCEL_OIDC_TOKEN is written by `vercel env pull`. Do not set it by hand.
